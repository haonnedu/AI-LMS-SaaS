# Development values only. Keep the real .env out of source control.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://eduvia:eduvia_dev_only@localhost:5432/eduvia
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HEALTH_TIMEOUT_SECONDS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eduvia-dev
# Optional. Set both credentials when connecting a local S3-compatible service.
# S3_ACCESS_KEY_ID=eduvia_dev
# S3_SECRET_ACCESS_KEY=eduvia_dev_only


# Configure together to enable authentication. Without these, protected API fails closed.
# AUTH_ISSUER=http://127.0.0.1:3000
# AUTH_AUDIENCE=https://eduvia-api
# AUTH_JWKS_URL=http://127.0.0.1:3000/api/auth/jwks

# Better Auth issuer is APP_BASE_URL without a trailing slash; staging requires HTTPS.

# Privacy (decision 0009). signup = accepting the user agreement + privacy notice at registration
# is the legal basis for every role; guardian = optional guardian-consent flow (migration 0016)
# for schools that ask for it. Bump TERMS_VERSION and PRIVACY_POLICY_VERSION together when the
# lawyer-approved text replaces the draft.
PRIVACY_CONSENT_MODE=signup
# PRIVACY_CONSENT_AGE=16
TERMS_VERSION=2026-10-draft
PRIVACY_POLICY_VERSION=2026-10-draft
