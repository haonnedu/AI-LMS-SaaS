# Docker Compose configuration for local development only.
# Native frontend/backend processes use their own .env.example files.
POSTGRES_DB=eduvia
POSTGRES_USER=eduvia
POSTGRES_PASSWORD=eduvia_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000


# Generate a separate private password before creating the auth role.
DB_AUTH_PASSWORD=replace_with_random_secret
# Google/SMTP/session settings for native services live in frontend/.env.local.
# Compose frontend needs the same server-only settings; see deploy/better-auth/README.md.

# Optional Mailpit profile for native local auth email testing:
# docker compose --profile dev-mail up -d --wait db redis mailpit
# SMTP 127.0.0.1:1025, UI http://127.0.0.1:8025; never sends Internet email.

 Docker Compose configuration for local development only.
# Native frontend/backend processes use their own .env.example files.
POSTGRES_DB=eduvia
POSTGRES_USER=eduvia
POSTGRES_PASSWORD=eduvia_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000
# Local MinIO (private bucket, loopback only). Dev credentials only; never reuse elsewhere.
MINIO_ROOT_USER=eduvia_dev
MINIO_ROOT_PASSWORD=eduvia_dev_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=eduvia-dev
S3_REGION=us-east-1
# Signed download URLs embed this endpoint; the in-network default only works inside Compose.
# S3_ENDPOINT_URL=http://minio:9000
UPLOAD_MAX_BYTES=26214400
