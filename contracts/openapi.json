{
  "components": {
    "schemas": {
      "BootstrapDTO": {
        "properties": {
          "personalWorkspace": {
            "$ref": "#/components/schemas/WorkspaceDTO"
          },
          "user": {
            "$ref": "#/components/schemas/UserDTO"
          }
        },
        "required": [
          "user",
          "personalWorkspace"
        ],
        "title": "BootstrapDTO",
        "type": "object"
      },
      "ErrorDTO": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "error",
          "requestId"
        ],
        "title": "ErrorDTO",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "service": {
            "const": "eduvia-api",
            "default": "eduvia-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "LiveResponse",
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "postgres": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Postgres",
            "type": "string"
          },
          "redis": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Redis",
            "type": "string"
          }
        },
        "required": [
          "postgres",
          "redis"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "UserDTO": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ],
        "title": "UserDTO",
        "type": "object"
      },
      "WorkspaceDTO": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "personal",
              "school"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "role"
        ],
        "title": "WorkspaceDTO",
        "type": "object"
      },
      "WorkspaceListDTO": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceDTO"
            },
            "title": "Items",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "WorkspaceListDTO",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Eduvia identity API: verified access tokens, atomic personal workspace bootstrap and membership-scoped workspace access. Teaching, AI and grading remain planned.",
    "title": "Eduvia API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Process liveness without external dependency checks.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Bounded concurrent probes; never returns connection details or credentials.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "A required dependency is unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
