{
  "name": "@eduvia/frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:workspace": "node --test tests/workspace-adapter.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "api:generate": "openapi-typescript ../contracts/openapi.json -o src/lib/api/generated.ts",
    "test:auth": "playwright test"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.33.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
