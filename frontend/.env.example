# Server-only fixed backend origin. Never put provider secrets in NEXT_PUBLIC_*.
# Docker Compose sets this to http://api:8000.
API_INTERNAL_URL=http://127.0.0.1:8000

# Better Auth. All fields server-only.
APP_BASE_URL=http://127.0.0.1:3000
SESSION_REDIS_URL=redis://127.0.0.1:6379/2
# SESSION_ENCRYPTION_KEY= # separate 32 random bytes encoded as 64 hex characters

# Configure after creating the dedicated auth role and applying migrations.
BETTER_AUTH_SECRET=
BETTER_AUTH_AUDIENCE=https://eduvia-api
AUTH_DATABASE_URL=postgresql://eduvia_auth_runtime:replace_me@127.0.0.1:5432/eduvia
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=smtp://127.0.0.1:1025
AUTH_EMAIL_FROM=Eduvia <auth@example.test>
