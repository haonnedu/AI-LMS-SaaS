# Server-only fixed backend origin. Never put provider secrets in NEXT_PUBLIC_*.
# Docker Compose sets this to http://api:8000.
API_INTERNAL_URL=http://127.0.0.1:8000

# Auth0 Regular Web Application, database connection only. All fields server-only.
APP_BASE_URL=http://127.0.0.1:3000
# AUTH0_DOMAIN=YOUR_TENANT.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET= # 32 random bytes encoded as 64 hex characters
# AUTH0_AUDIENCE=https://eduvia-api
AUTH0_CONNECTION=Username-Password-Authentication
SESSION_REDIS_URL=redis://127.0.0.1:6379/2
# SESSION_ENCRYPTION_KEY= # separate 32 random bytes encoded as 64 hex characters
# M2M application with update:users, used only for verification-email jobs.
# AUTH0_MANAGEMENT_CLIENT_ID=
# AUTH0_MANAGEMENT_CLIENT_SECRET=
